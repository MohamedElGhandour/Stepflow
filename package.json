{
  "name": "@mohamedelghandour/stepflow",
  "version": "2.0.0",
  "description": "A tiny React library for product tours and onboarding walkthroughs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/stepflow.cjs",
  "module": "./dist/esm/stepflow.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/stepflow.js",
      "require": "./dist/cjs/stepflow.cjs",
      "default": "./dist/esm/stepflow.js"
    },
    "./styles.css": "./dist/styles/stepflow.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rollup -c && npm run build:css && npm run build:demo",
    "build:css": "sass src/styles/stepflow.scss dist/styles/stepflow.css --no-source-map --style=expanded",
    "dev": "rollup -c --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify-pack": "node scripts/verify-pack.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run check && npm run test && npm run build && npm run verify-pack",
    "build:demo": "cp dist/esm/stepflow.js dist/esm/stepflow.js.map public/vendor/ && cp dist/styles/stepflow.css public/vendor/",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev doc",
    "docs:build": "npm run docs:prepare && vitepress build doc",
    "docs:preview": "vitepress preview doc"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedElGhandour/Stepflow.git"
  },
  "keywords": [
    "react",
    "onboarding",
    "product-tour",
    "tour",
    "walkthrough",
    "guide",
    "intro"
  ],
  "author": "Mohamed Elghandour",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MohamedElGhandour/Stepflow/issues"
  },
  "homepage": "https://github.com/MohamedElGhandour/Stepflow#readme",
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "happy-dom": "^17.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.36.0",
    "sass": "^1.86.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
